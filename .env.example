# Local PostgreSQL (non-model keys). Copy to .env at the zip root if you change host/port.
DATABASE_URL=postgresql://blubird:blubird@127.0.0.1:5433/fieldwren?schema=public
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=blubird
POSTGRES_PASSWORD=blubird
POSTGRES_DB=fieldwren

# Model keys live in code/backend/.env (never NEXT_PUBLIC_* — the browser must not see them).
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-lite-latest
# XAI_API_KEY=...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
